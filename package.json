{
  "name": "comprice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write ./src/"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 130,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "eslintConfig": {
    "extends": "next/core-web-vitals"
  },
  "dependencies": {
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@mantine/core": "^7.7.0",
    "@mantine/form": "^7.7.1",
    "@mantine/hooks": "^7.7.0",
    "@next/bundle-analyzer": "^14.1.4",
    "@prisma/client": "^5.10.2",
    "@tabler/icons-react": "^3.1.0",
    "bcrypt-ts": "^5.0.2",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "lucia": "^3.1.1",
    "mantine-form-zod-resolver": "^1.1.0",
    "next": "14.1.0",
    "oslo": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^3.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.63",
    "@types/react-dom": "^18.2.20",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.13.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "^5.10.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
